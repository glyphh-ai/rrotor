{
  "_": "The vendors' agent CLIs the image carries (docs/architecture.md, 5.7, built-in CLIs): each pinned to a version and the SHA-256 of its download for linux amd64 and arm64, unpacked by image/clis.py under /usr/local/lib/rrotor-clis/<name>/ with `command` linked into /usr/local/bin, and its manifest (`manifest`, install from the image) written beside it, which rrotord deploys at boot as a built-in CLI. Raise a pin here: version, url and sha256 of both builds.",
  "clis": {
    "claude": {
      "vendor": "Anthropic",
      "title": "Claude Code",
      "version": "2.1.316",
      "command": "claude",
      "builds": {
        "amd64": {
          "url": "https://registry.npmjs.org/@anthropic-ai/claude-code-linux-x64/-/claude-code-linux-x64-2.1.316.tgz",
          "sha256": "745e1b196eb475161a185a00f5e1144d7324ec6094e21149eae719fa42481000",
          "entry": "package/claude"
        },
        "arm64": {
          "url": "https://registry.npmjs.org/@anthropic-ai/claude-code-linux-arm64/-/claude-code-linux-arm64-2.1.316.tgz",
          "sha256": "3a948e45a0c79d1b41e5e40bb4163b5f9e4a193c16ed72c949d8e5f55e9d875d",
          "entry": "package/claude"
        }
      },
      "manifest": {
        "description": "Claude Code, Anthropic's coding agent. Sign in once with cli_login (a claude.ai account, so its connectors come too), then run `-p <prompt>`.",
        "cli": {
          "allow": ["-p *", "--print *", "* -p *", "* --print *", "auth status*", "auth logout", "mcp list", "mcp get *", "--version", "--help"],
          "approvals": ["auth logout"],
          "env": { "DISABLE_AUTOUPDATER": "1", "ANTHROPIC_API_KEY": "secret?:ANTHROPIC_API_KEY" },
          "home": true,
          "login": { "args": ["auth", "login", "--claudeai"], "listen": true, "signed_in": ".claude/.credentials.json" }
        },
        "hosts": ["*.anthropic.com", "claude.ai", "*.claude.ai", "claude.com", "*.claude.com"],
        "secrets": ["ANTHROPIC_API_KEY"],
        "limits": { "seconds": 900, "memory_mb": 4096 }
      }
    },
