{
  "name": "@glyphh/rrotor",
  "version": "1.0.1-beta.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "rrotor — Recursive Reasoning on top of reasoning. The open runtime for RotorSpec, the standard for deterministic agent loops.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Glyphh AI LLC",
  "homepage": "https://github.com/glyphh-ai/rrotor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glyphh-ai/rrotor.git"
  },
  "bugs": {
    "url": "https://github.com/glyphh-ai/rrotor/issues"
  },
  "keywords": [
    "rotorspec",
    "agent",
    "agent-loop",
    "deterministic",
    "llm",
    "ai",
    "runtime"
  ],
  "bin": {
    "rrotor": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "spec",
    "rotors",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "dev": "tsx src/cli.ts",
    "repl": "tsx src/cli.ts repl",
    "chat": "tsx src/cli.ts chat",
    "start": "node dist/cli.js",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint .",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@eslint/js": "^9.9.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.31",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.9.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.9",
    "ws": "^8.21.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.263",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "yaml": "^2.9.0"
  }
}
