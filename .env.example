# rrotor configuration — copy to `.env` (project) or `~/.rrotor/.env` (user).
# Precedence: exported shell environment > ./.env > ~/.rrotor/.env.
# The TUI's /model and /store commands persist to ~/.rrotor/config.json;
# anything set here (or in the shell) wins over that file.

# ── models: the LOCAL lane (free by construction) ───────────────────────────
# Any OpenAI-compatible endpoint: llama.cpp, Ollama, vLLM, LM Studio, …
ROTOR_MODEL_URL=http://127.0.0.1:8080
# Model id sent to the local endpoint (llama.cpp: match your --alias).
ROTOR_MODEL_ID=glyphh-local
# Per-call model timeout in ms (default 120000 — local models on long
# prompts are slow; a timeout degrades the lane and is reported in the step).
#ROTOR_MODEL_TIMEOUT=120000

# ── models: the FRONTIER lane (metered; the escalation rung §9) ─────────────
# The provider wire is inferred from the host: api.anthropic.com speaks the
# Claude Messages API; every other URL speaks OpenAI chat-completions.
#ROTOR_FRONTIER_URL=https://api.anthropic.com
#ROTOR_FRONTIER_MODEL=claude-sonnet-4-5
#ROTOR_FRONTIER_KEY=sk-ant-…

# ── provider keys (conventional names) ──────────────────────────────────────
# Used automatically wherever a binding needs a key and none was stored via
# the TUI: per-role /model bindings and the frontier lane alike.
#ANTHROPIC_API_KEY=sk-ant-…
#OPENAI_API_KEY=sk-…

# ── memory: the stator (state lives here; compute is stateless) ─────────────
# Unset = ephemeral in-process. sqlite = durable single file (WAL, safe for
# concurrent local processes). pgvector = Postgres (ANN recall at scale).
ROTOR_STATOR_BACKEND=sqlite
ROTOR_STATOR_URL=~/.rrotor/stator.db
#ROTOR_STATOR_BACKEND=pgvector
#ROTOR_STATOR_URL=postgres://user:pass@localhost:5432/rrotor

# ── serve: the HTTP runtime (probes · POST /run · SSE · /ws) ────────────────
#ROTOR_PORT=8080

# ── observability ───────────────────────────────────────────────────────────
# Logs go to stderr; pretty for humans, json for collectors.
#ROTOR_LOG_FORMAT=json
#ROTOR_LOG_LEVEL=debug
# Telemetry drain: every StepRecord fans out here after the durable write.
#ROTOR_DRAIN_URL=https://collector.example.com/v1/rotor
#ROTOR_DRAIN_TOKEN=…
#ROTOR_DRAIN_FILE=/var/log/rrotor/steps.jsonl
#ROTOR_DRAIN_BATCH=32
#ROTOR_DRAIN_BUFFER=1024
# Comma-separated output fields to redact before records leave the process.
#ROTOR_DRAIN_REDACT=content,filler

# ── misc ────────────────────────────────────────────────────────────────────
# Banner variant: full | wordmark | mark | min
#RROTOR_LOGO=full
# Tool sandbox root override (default: the directory you launch from).
#ROTOR_WORKSPACE=/path/to/workspace
